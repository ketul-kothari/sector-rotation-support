    => ""

// --- 3. PARSER ---
pairs_arr = str.split(data_string, ",")
get_s(idx) => 
    string t = ""
    if idx < array.size(pairs_arr)
        parts = str.split(array.get(pairs_arr, idx), ":")
        if array.size(parts) >= 2
            t := str.replace_all(array.get(parts,0)+":"+array.get(parts,1)," ","")
    t

// --- 4. FETCH DATA ---
f(t) =>
    if t == ""
        [float(na), float(na), float(na), float(na)]
    else
        request.security(t, timeframe.period, [open, high, low, close])

[o01,h01,l01,c01]=f(get_s(0)), [o02,h02,l02,c02]=f(get_s(1)), [o03,h03,l03,c03]=f(get_s(2)), [o04,h04,l04,c04]=f(get_s(3)), [o05,h05,l05,c05]=f(get_s(4))
[o06,h06,l06,c06]=f(get_s(5)), [o07,h07,l07,c07]=f(get_s(6)), [o08,h08,l08,c08]=f(get_s(7)), [o09,h09,l09,c09]=f(get_s(8)), [o10,h10,l10,c10]=f(get_s(9))
[o11,h11,l11,c11]=f(get_s(10)), [o12,h12,l12,c12]=f(get_s(11)), [o13,h13,l13,c13]=f(get_s(12)), [o14,h14,l14,c14]=f(get_s(13)), [o15,h15,l15,c15]=f(get_s(14))
[o16,h16,l16,c16]=f(get_s(15)), [o17,h17,l17,c17]=f(get_s(16)), [o18,h18,l18,c18]=f(get_s(17)), [o19,h19,l19,c19]=f(get_s(18)), [o20,h20,l20,c20]=f(get_s(19))
[o21,h21,l21,c21]=f(get_s(20)), [o22,h22,l22,c22]=f(get_s(21)), [o23,h23,l23,c23]=f(get_s(22)), [o24,h24,l24,c24]=f(get_s(23)), [o25,h25,l25,c25]=f(get_s(24))
[o26,h26,l26,c26]=f(get_s(25)), [o27,h27,l27,c27]=f(get_s(26)), [o28,h28,l28,c28]=f(get_s(27)), [o29,h29,l29,c29]=f(get_s(28)), [o30,h30,l30,c30]=f(get_s(29))
[o31,h31,l31,c31]=f(get_s(30)), [o32,h32,l32,c32]=f(get_s(31)), [o33,h33,l33,c33]=f(get_s(32)), [o34,h34,l34,c34]=f(get_s(33)), [o35,h35,l35,c35]=f(get_s(34))
[o36,h36,l36,c36]=f(get_s(35)), [o37,h37,l37,c37]=f(get_s(36)), [o38,h38,l38,c38]=f(get_s(37)), [o39,h39,l39,c39]=f(get_s(38))

// --- 5. RETURN CALCULATION ENGINE ---
ret(val, prev) => 
    float r = 0.0
    float valid = 0.0
    if not na(val) and not na(prev) and prev != 0
        r := ((val / prev) - 1)
        valid := 1.0
    [r, valid]

[rO01, v01] = ret(o01, c01[1]), [rH01, v_h01] = ret(h01, c01[1]), [rL01, v_l01] = ret(l01, c01[1]), [rC01, v_c01] = ret(c01, c01[1])
[rO02, v02] = ret(o02, c02[1]), [rH02, v_h02] = ret(h02, c02[1]), [rL02, v_l02] = ret(l02, c02[1]), [rC02, v_c02] = ret(c02, c02[1])
