[rO23, v23] = ret(o23, c23[1]), [rH23, v_h23] = ret(h23, c23[1]), [rL23, v_l23] = ret(l23, c23[1]), [rC23, v_c23] = ret(c23, c23[1])
[rO24, v24] = ret(o24, c24[1]), [rH24, v_h24] = ret(h24, c24[1]), [rL24, v_l24] = ret(l24, c24[1]), [rC24, v_c24] = ret(c24, c24[1])
[rO25, v25] = ret(o25, c25[1]), [rH25, v_h25] = ret(h25, c25[1]), [rL25, v_l25] = ret(l25, c25[1]), [rC25, v_c25] = ret(c25, c25[1])
