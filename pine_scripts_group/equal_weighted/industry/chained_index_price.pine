[rO33, v33] = ret(o33, c33[1]), [rH33, v_h33] = ret(h33, c33[1]), [rL33, v_l33] = ret(l33, c33[1]), [rC33, v_c33] = ret(c33, c33[1])
[rO34, v34] = ret(o34, c34[1]), [rH34, v_h34] = ret(h34, c34[1]), [rL34, v_l34] = ret(l34, c34[1]), [rC34, v_c34] = ret(c34, c34[1])
[rO35, v35] = ret(o35, c35[1]), [rH35, v_h35] = ret(h35, c35[1]), [rL35, v_l35] = ret(l35, c35[1]), [rC35, v_c35] = ret(c35, c35[1])
[rO36, v36] = ret(o36, c36[1]), [rH36, v_h36] = ret(h36, c36[1]), [rL36, v_l36] = ret(l36, c36[1]), [rC36, v_c36] = ret(c36, c36[1])
[rO37, v37] = ret(o37, c37[1]), [rH37, v_h37] = ret(h37, c37[1]), [rL37, v_l37] = ret(l37, c37[1]), [rC37, v_c37] = ret(c37, c37[1])
[rO38, v38] = ret(o38, c38[1]), [rH38, v_h38] = ret(h38, c38[1]), [rL38, v_l38] = ret(l38, c38[1]), [rC38, v_c38] = ret(c38, c38[1])
[rO39, v39] = ret(o39, c39[1]), [rH39, v_h39] = ret(h39, c39[1]), [rL39, v_l39] = ret(l39, c39[1]), [rC39, v_c39] = ret(c39, c39[1])

// --- 6. SUMMATION (Equal Weighted) ---
totActive = v01+v02+v03+v04+v05+v06+v07+v08+v09+v10+v11+v12+v13+v14+v15+v16+v17+v18+v19+v20+v21+v22+v23+v24+v25+v26+v27+v28+v29+v30+v31+v32+v33+v34+v35+v36+v37+v38+v39
sumO = rO01+rO02+rO03+rO04+rO05+rO06+rO07+rO08+rO09+rO10+rO11+rO12+rO13+rO14+rO15+rO16+rO17+rO18+rO19+rO20+rO21+rO22+rO23+rO24+rO25+rO26+rO27+rO28+rO29+rO30+rO31+rO32+rO33+rO34+rO35+rO36+rO37+rO38+rO39
sumH = rH01+rH02+rH03+rH04+rH05+rH06+rH07+rH08+rH09+rH10+rH11+rH12+rH13+rH14+rH15+rH16+rH17+rH18+rH19+rH20+rH21+rH22+rH23+rH24+rH25+rH26+rH27+rH28+rH29+rH30+rH31+rH32+rH33+rH34+rH35+rH36+rH37+rH38+rH39
sumL = rL01+rL02+rL03+rL04+rL05+rL06+rL07+rL08+rL09+rL10+rL11+rL12+rL13+rL14+rL15+rL16+rL17+rL18+rL19+rL20+rL21+rL22+rL23+rL24+rL25+rL26+rL27+rL28+rL29+rL30+rL31+rL32+rL33+rL34+rL35+rL36+rL37+rL38+rL39
sumC = rC01+rC02+rC03+rC04+rC05+rC06+rC07+rC08+rC09+rC10+rC11+rC12+rC13+rC14+rC15+rC16+rC17+rC18+rC19+rC20+rC21+rC22+rC23+rC24+rC25+rC26+rC27+rC28+rC29+rC30+rC31+rC32+rC33+rC34+rC35+rC36+rC37+rC38+rC39

// --- 7. ACCUMULATION ---
var idx_C = 100.0
pC = nz(idx_C[1], 100.0)

fO = totActive > 0 ? sumO / totActive : 0.0
fH = totActive > 0 ? sumH / totActive : 0.0
fL = totActive > 0 ? sumL / totActive : 0.0
fC = totActive > 0 ? sumC / totActive : 0.0

idx_O = pC * (1 + fO)
idx_H = pC * (1 + fH)
idx_L = pC * (1 + fL)
idx_C := pC * (1 + fC)

// --- 8. PLOTTING ---
plotcandle(idx_O, idx_H, idx_L, idx_C, "Index", idx_C >= idx_O ? #089981 : #f23645, bordercolor=idx_C >= idx_O ? #089981 : #f23645)

fast_sma = ta.sma(idx_C, timeframe.isweekly ? 10 : 50)
slow_sma = ta.sma(idx_C, timeframe.isweekly ? 30 : 150)

plot(fast_sma, "Fast SMA", color=#089981, display=display.all)
plot(slow_sma, "Slow SMA", color=#7e57c2, display=display.all)

plot(fC * 100, "Daily Change %", color=fC >= 0 ? #089981 : #f23645, display=display.status_line + display.data_window, format=format.percent)

stock_count = data_string == "" ? 0 : array.size(pairs_arr)
display_text = "Industry: " + industry_choice + " (count: " + str.tostring(stock_count) + ")"

var head_tab = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(head_tab, 0, 0, display_text, text_color=color.white, bgcolor=color.new(#111111, 10), text_size=size.small)

// --- 9. ALERTS ---
bullish_cross = ta.crossover(fast_sma, slow_sma)
bearish_cross = ta.crossunder(fast_sma, slow_sma)

price_cross_up_fast = ta.crossover(idx_C, fast_sma)
price_cross_dn_fast = ta.crossunder(idx_C, fast_sma)

price_cross_up_slow = ta.crossover(idx_C, slow_sma)
price_cross_dn_slow = ta.crossunder(idx_C, slow_sma)

alertcondition(bullish_cross, title="Bullish Alert: Fast crosses ABOVE Slow", message="The Fast SMA has crossed above the Slow SMA on the custom index.")
alertcondition(bearish_cross, title="Bearish Alert: Fast crosses BELOW Slow", message="The Fast SMA has crossed below the Slow SMA on the custom index.")

alertcondition(price_cross_up_fast, title="Bullish Alert: Price > Fast SMA", message="The Index Price has crossed ABOVE the Fast SMA (50).")
alertcondition(price_cross_dn_fast, title="Bearish Alert: Price < Fast SMA", message="The Index Price has crossed BELOW the Fast SMA (50).")

alertcondition(price_cross_up_slow, title="Bullish Alert: Price > Slow SMA", message="The Index Price has crossed ABOVE the Slow SMA (150).")
alertcondition(price_cross_dn_slow, title="Bearish Alert: Price < Slow SMA", message="The Index Price has crossed BELOW the Slow SMA (150).")