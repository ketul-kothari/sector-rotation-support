    "Telecom - Services" => "NSE:BHARTIARTL, NSE:INDUSTOWER, NSE:IDEA, NSE:BHARTIHEXA, NSE:TATACOMM, NSE:HFCL, NSE:RAILTEL, NSE:TTML, NSE:ROUTE, NSE:MTNL, NSE:GTLINFRA, NSE:VINDHYATEL"
    "Textiles & Apparels" => "NSE:PAGEIND, NSE:KPRMILL, NSE:VTL, NSE:TRIDENT, NSE:WELSPUNLIV, NSE:ARVIND, NSE:PGIL, NSE:ALOKINDS, NSE:GARFIBRES, NSE:GOKEX, NSE:ICIL, NSE:LUXIND, NSE:RAYMONDLSL, NSE:PDSL, NSE:SANATHAN, NSE:KITEX, NSE:KKCL, NSE:GANECOS, NSE:SANGAMIND, NSE:JINDWORLD, NSE:SIYSIL, NSE:NITINSPIN, NSE:BOMDYEING, NSE:CANTABIL, NSE:SPAL, NSE:FILATEX, NSE:DOLLAR, NSE:SPORTKING, NSE:SBC, NSE:SUMEETINDS, NSE:AYMSYNTEX, NSE:RUPA, NSE:RAJRILTD, NSE:MONTECARLO, NSE:FAZE3Q, NSE:HIMATSEIDE, NSE:INDORAMA"
    "Transport Infrastructure" => "NSE:ADANIPORTS, NSE:GMRAIRPORT, NSE:JSWINFRA, NSE:GPPL, NSE:BFUTILITIE"
    "Transport Services" => "NSE:INDIGO, NSE:CONCOR, NSE:DELHIVERY, NSE:GESHIP, NSE:SCI, NSE:BLUEDART, NSE:BLACKBUCK, NSE:TCI, NSE:TVSSCS, NSE:VRLLOG, NSE:MAHLOG, NSE:SEAMECLTD, NSE:SINDHUTRAD, NSE:GATEWAY, NSE:KERNEX, NSE:TCIEXP, NSE:NAVKARCORP, NSE:ALLCARGO, NSE:RIIL, NSE:WCIL"
    => ""

pairs_arr = str.split(data_string, ",")
get_s(idx) => 
    string t = ""
    if idx < pairs_arr.size()
        parts = str.split(pairs_arr.get(idx), ":")
        t := parts.size() >= 2 ? str.replace_all(parts.get(0) + ":" + parts.get(1), " ", "") : ""
    t

// --- 4. FETCH DATA ---
f(ticker) => 
    if ticker == ""
        [float(na), float(na), float(na)]
    else
        request.security(ticker, timeframe.period, [open, close, volume])

[o01,c01,v01]=f(get_s(0)), [o02,c02,v02]=f(get_s(1)), [o03,c03,v03]=f(get_s(2)), [o04,c04,v04]=f(get_s(3)), [o05,c05,v05]=f(get_s(4))
[o06,c06,v06]=f(get_s(5)), [o07,c07,v07]=f(get_s(6)), [o08,c08,v08]=f(get_s(7)), [o09,c09,v09]=f(get_s(8)), [o10,c10,v10]=f(get_s(9))
[o11,c11,v11]=f(get_s(10)), [o12,c12,v12]=f(get_s(11)), [o13,c13,v13]=f(get_s(12)), [o14,c14,v14]=f(get_s(13)), [o15,c15,v15]=f(get_s(14))
[o16,c16,v16]=f(get_s(15)), [o17,c17,v17]=f(get_s(16)), [o18,c18,v18]=f(get_s(17)), [o19,c19,v19]=f(get_s(18)), [o20,c20,v20]=f(get_s(19))
[o21,c21,v21]=f(get_s(20)), [o22,c22,v22]=f(get_s(21)), [o23,c23,v23]=f(get_s(22)), [o24,c24,v24]=f(get_s(23)), [o25,c25,v25]=f(get_s(24))
[o26,c26,v26]=f(get_s(25)), [o27,c27,v27]=f(get_s(26)), [o28,c28,v28]=f(get_s(27)), [o29,c29,v29]=f(get_s(28)), [o30,c30,v30]=f(get_s(29))
[o31,c31,v31]=f(get_s(30)), [o32,c32,v32]=f(get_s(31)), [o33,c33,v33]=f(get_s(32)), [o34,c34,v34]=f(get_s(33)), [o35,c35,v35]=f(get_s(34))
[o36,c36,v36]=f(get_s(35)), [o37,c37,v37]=f(get_s(36)), [o38,c38,v38]=f(get_s(37)), [o39,c39,v39]=f(get_s(38))

// --- 5. SUMMATION ---
idx_o = nz(o01)+nz(o02)+nz(o03)+nz(o04)+nz(o05)+nz(o06)+nz(o07)+nz(o08)+nz(o09)+nz(o10)+nz(o11)+nz(o12)+nz(o13)+nz(o14)+nz(o15)+nz(o16)+nz(o17)+nz(o18)+nz(o19)+nz(o20)+nz(o21)+nz(o22)+nz(o23)+nz(o24)+nz(o25)+nz(o26)+nz(o27)+nz(o28)+nz(o29)+nz(o30)+nz(o31)+nz(o32)+nz(o33)+nz(o34)+nz(o35)+nz(o36)+nz(o37)+nz(o38)+nz(o39)
idx_c = nz(c01)+nz(c02)+nz(c03)+nz(c04)+nz(c05)+nz(c06)+nz(c07)+nz(c08)+nz(c09)+nz(c10)+nz(c11)+nz(c12)+nz(c13)+nz(c14)+nz(c15)+nz(c16)+nz(c17)+nz(c18)+nz(c19)+nz(o20)+nz(c21)+nz(c22)+nz(c23)+nz(c24)+nz(c25)+nz(c26)+nz(c27)+nz(c28)+nz(c29)+nz(c30)+nz(c31)+nz(c32)+nz(c33)+nz(c34)+nz(c35)+nz(c36)+nz(c37)+nz(c38)+nz(c39)
v_tot = (nz(v01)+nz(v02)+nz(v03)+nz(v04)+nz(v05)+nz(v06)+nz(v07)+nz(v08)+nz(v09)+nz(v10)+nz(v11)+nz(v12)+nz(v13)+nz(v14)+nz(v15)+nz(v16)+nz(v17)+nz(v18)+nz(v19)+nz(v20)+nz(v21)+nz(v22)+nz(v23)+nz(v24)+nz(v25)+nz(v26)+nz(v27)+nz(v28)+nz(v29)+nz(v30)+nz(v31)+nz(v32)+nz(v33)+nz(v34)+nz(v35)+nz(v36)+nz(v37)+nz(v38)+nz(v39))

// --- 6. PLOTTING ---
vol_color = idx_c >= idx_o ? #089981 : #f23645
plot(v_tot, "Total Volume", style=plot.style_columns, color=color.new(vol_color, 40))
plot(ta.sma(v_tot, vol_len), "Vol SMA", color=#2196f3, linewidth=1)

// Header
stock_count = data_string == "" ? 0 : array.size(pairs_arr)
display_text = "Industry: " + industry_choice + " (count: " + str.tostring(stock_count) + ")"
var head_tab = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(head_tab, 0, 0, display_text, text_color=color.white, bgcolor=color.new(#111111, 10), text_size=size.small)