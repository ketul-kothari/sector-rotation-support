    "Telecom - Equipment & Accessories" => "NSE:ITI, NSE:STLTECH, NSE:TEJASNET, NSE:OPTIEMUS"
    "Telecom - Services" => "NSE:BHARTIARTL, NSE:INDUSTOWER, NSE:IDEA, NSE:BHARTIHEXA, NSE:TATACOMM, NSE:HFCL, NSE:RAILTEL, NSE:TTML, NSE:ROUTE, NSE:MTNL, NSE:GTLINFRA, NSE:VINDHYATEL"
    "Textiles & Apparels" => "NSE:PAGEIND, NSE:KPRMILL, NSE:VTL, NSE:TRIDENT, NSE:WELSPUNLIV, NSE:ARVIND, NSE:PGIL, NSE:ALOKINDS, NSE:GARFIBRES, NSE:GOKEX, NSE:ICIL, NSE:LUXIND, NSE:RAYMONDLSL, NSE:PDSL, NSE:SANATHAN, NSE:KITEX, NSE:KKCL, NSE:GANECOS, NSE:SANGAMIND, NSE:JINDWORLD, NSE:SIYSIL, NSE:NITINSPIN, NSE:BOMDYEING, NSE:CANTABIL, NSE:SPAL, NSE:FILATEX, NSE:DOLLAR, NSE:SPORTKING, NSE:SBC, NSE:SUMEETINDS, NSE:AYMSYNTEX, NSE:RUPA, NSE:RAJRILTD, NSE:MONTECARLO, NSE:FAZE3Q, NSE:HIMATSEIDE, NSE:INDORAMA"
    "Transport Infrastructure" => "NSE:ADANIPORTS, NSE:GMRAIRPORT, NSE:JSWINFRA, NSE:GPPL, NSE:BFUTILITIE"
    "Transport Services" => "NSE:INDIGO, NSE:CONCOR, NSE:DELHIVERY, NSE:GESHIP, NSE:SCI, NSE:BLUEDART, NSE:BLACKBUCK, NSE:TCI, NSE:TVSSCS, NSE:VRLLOG, NSE:MAHLOG, NSE:SEAMECLTD, NSE:SINDHUTRAD, NSE:GATEWAY, NSE:KERNEX, NSE:TCIEXP, NSE:NAVKARCORP, NSE:ALLCARGO, NSE:RIIL, NSE:WCIL"
    => ""

// --- 3. PARSER ---
pairs_arr = str.split(data_string, ",")
get_s(idx) => 
    string t = ""
    if idx < array.size(pairs_arr)
        parts = str.split(array.get(pairs_arr, idx), ":")
        if array.size(parts) >= 2
            t := str.replace_all(array.get(parts,0)+":"+array.get(parts,1)," ","")
    t

// --- 4. FETCH DATA (39 Slots) ---
f(t) => t == "" ? float(na) : request.security(t, timeframe.period, close)

c01=f(get_s(0)), c02=f(get_s(1)), c03=f(get_s(2)), c04=f(get_s(3)), c05=f(get_s(4))
c06=f(get_s(5)), c07=f(get_s(6)), c08=f(get_s(7)), c09=f(get_s(8)), c10=f(get_s(9))
c11=f(get_s(10)), c12=f(get_s(11)), c13=f(get_s(12)), c14=f(get_s(13)), c15=f(get_s(14))
c16=f(get_s(15)), c17=f(get_s(16)), c18=f(get_s(17)), c19=f(get_s(18)), c20=f(get_s(19))
c21=f(get_s(20)), c22=f(get_s(21)), c23=f(get_s(22)), c24=f(get_s(23)), c25=f(get_s(24))
c26=f(get_s(25)), c27=f(get_s(26)), c28=f(get_s(27)), c29=f(get_s(28)), c30=f(get_s(29))
c31=f(get_s(30)), c32=f(get_s(31)), c33=f(get_s(32)), c34=f(get_s(33)), c35=f(get_s(34))
c36=f(get_s(35)), c37=f(get_s(36)), c38=f(get_s(37)), c39=f(get_s(38))

// --- 5. RETURN CALCULATION ENGINE ---
ret(val, prev) => 
    float r = 0.0
    float valid = 0.0
    if not na(val) and not na(prev) and prev != 0
        r := ((val / prev) - 1)
        valid := 1.0
    [r, valid]

[rC01, v01] = ret(c01, c01[1]), [rC02, v02] = ret(c02, c02[1]), [rC03, v03] = ret(c03, c03[1])
[rC04, v04] = ret(c04, c04[1]), [rC05, v05] = ret(c05, c05[1]), [rC06, v06] = ret(c06, c06[1])
[rC07, v07] = ret(c07, c07[1]), [rC08, v08] = ret(c08, c08[1]), [rC09, v09] = ret(c09, c09[1])
[rC10, v10] = ret(c10, c10[1]), [rC11, v11] = ret(c11, c11[1]), [rC12, v12] = ret(c12, c12[1])
[rC13, v13] = ret(c13, c13[1]), [rC14, v14] = ret(c14, c14[1]), [rC15, v15] = ret(c15, c15[1])
[rC16, v16] = ret(c16, c16[1]), [rC17, v17] = ret(c17, c17[1]), [rC18, v18] = ret(c18, c18[1])
[rC19, v19] = ret(c19, c19[1]), [rC20, v20] = ret(c20, c20[1]), [rC21, v21] = ret(c21, c21[1])
[rC22, v22] = ret(c22, c22[1]), [rC23, v23] = ret(c23, c23[1]), [rC24, v24] = ret(c24, c24[1])
[rC25, v25] = ret(c25, c25[1]), [rC26, v26] = ret(c26, c26[1]), [rC27, v27] = ret(c27, c27[1])
[rC28, v28] = ret(c28, c28[1]), [rC29, v29] = ret(c29, c29[1]), [rC30, v30] = ret(c30, c30[1])
[rC31, v31] = ret(c31, c31[1]), [rC32, v32] = ret(c32, c32[1]), [rC33, v33] = ret(c33, c33[1])
[rC34, v34] = ret(c34, c34[1]), [rC35, v35] = ret(c35, c35[1]), [rC36, v36] = ret(c36, c36[1])
[rC37, v37] = ret(c37, c37[1]), [rC38, v38] = ret(c38, c38[1]), [rC39, v39] = ret(c39, c39[1])

// --- 6. SUMMATION & ACCUMULATION (Equal Weighted) ---
totActive = v01+v02+v03+v04+v05+v06+v07+v08+v09+v10+v11+v12+v13+v14+v15+v16+v17+v18+v19+v20+v21+v22+v23+v24+v25+v26+v27+v28+v29+v30+v31+v32+v33+v34+v35+v36+v37+v38+v39
sumC = rC01+rC02+rC03+rC04+rC05+rC06+rC07+rC08+rC09+rC10+rC11+rC12+rC13+rC14+rC15+rC16+rC17+rC18+rC19+rC20+rC21+rC22+rC23+rC24+rC25+rC26+rC27+rC28+rC29+rC30+rC31+rC32+rC33+rC34+rC35+rC36+rC37+rC38+rC39

var idx_C = 100.0
pC = nz(idx_C[1], 100.0)
fC = totActive > 0 ? sumC / totActive : 0.0
idx_C := pC * (1 + fC)

// --- 7. MANSFIELD RS CALC (Time Aware) ---
// Scale input weeks to the correct number of bars based on the chart's timeframe
int final_len = len_input_weeks
if timeframe.isdaily
    final_len := math.round(len_input_weeks * (252.0 / 52.0))
else if timeframe.ismonthly
    final_len := math.max(1, math.round(len_input_weeks / 4.333))

bench_c   = request.security(bench, timeframe.period, close)
ratio     = idx_C / nz(bench_c, 1)
m_rs      = ((ratio / ta.sma(ratio, final_len)) - 1) * 10

// --- 8. PLOTTING ---
rs_plot = plot(m_rs, "Mansfield RS", color=color.gray, linewidth=1)
z_plot  = plot(0, "Zero Line", color=color.new(#000000, 0))
fill(rs_plot, z_plot, m_rs >= 0 ? m_rs : 0, 0, color.new(#098b76, 25), color.new(#098b76, 25))
fill(rs_plot, z_plot, 0, m_rs < 0 ? m_rs : 0, color.new(#850812, 25), color.new(#850813, 25))

// Header
stock_count = data_string == "" ? 0 : array.size(pairs_arr)
display_text = "Industry: " + industry_choice + " (count: " + str.tostring(stock_count) + ")"
var head_tab = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(head_tab, 0, 0, display_text, text_color=color.white, bgcolor=color.new(#111111, 10), text_size=size.small)

// --- 9. ALERTS ---
rs_cross_up = ta.crossover(m_rs, 0)
alertcondition(rs_cross_up, title="Mansfield RS Crossed Above Zero", message="The Mansfield RS for the selected industry index has crossed above 0.")