//@version=6
indicator("Industry Master - Chained Index Mansfield RS (Equal Weighted)", overlay=false, precision=4, max_bars_back=5000)

// --- 1. INDUSTRY & BENCHMARK INPUTS ---
industry_choice = input.string("Aerospace & Defense", "Select Industry", options=[
     "Aerospace & Defense", "Agricultural Food & other Products", "Agricultural, Commercial & Construction Vehicles", 
     "Auto Components", "Automobiles", "Banks", "Beverages", "Capital Markets", "Cement & Cement Products", 
     "Chemicals & Petrochemicals", "Cigarettes & Tobacco Products", "Commercial Services & Supplies", 
     "Construction", "Consumable Fuels", "Consumer Durables", "Diversified", "Diversified FMCG", 
     "Diversified Metals", "Electrical Equipment", "Engineering Services", "Entertainment", 
     "Ferrous Metals", "Fertilizers & Agrochemicals", "Finance", "Financial Technology (Fintech)", 
     "Food Products", "Gas", "Healthcare Equipment & Supplies", "Healthcare Services", 
     "Household Products", "IT - Hardware", "IT - Services", "IT - Software", "Industrial Manufacturing", 
     "Industrial Products", "Insurance", "Leisure Services", "Media", "Metals & Minerals Trading", 
     "Minerals & Mining", "Non - Ferrous Metals", "Oil", "Other Construction Materials", 
     "Other Consumer Services", "Other Utilities", "Paper, Forest & Jute Products", 
     "Personal Products", "Petroleum Products", "Pharmaceuticals & Biotechnology", "Power", 
     "Printing & Publication", "Realty", "Retailing", "Telecom - Equipment & Accessories", 
     "Telecom - Services", "Textiles & Apparels", "Transport Infrastructure", "Transport Services"
     ])

bench           = input.string("NSE:CNX500", "Benchmark")
len_input_weeks = input.int(52, "RS Length (in Weeks)")

// --- 2. DATA REPOSITORY ---
