    "Telecom - Services" => "NSE:BHARTIARTL, NSE:INDUSTOWER, NSE:IDEA, NSE:BHARTIHEXA, NSE:TATACOMM, NSE:HFCL, NSE:RAILTEL, NSE:TTML, NSE:PACEDIGITK, NSE:ROUTE, NSE:MTNL, NSE:GTLINFRA, NSE:VINDHYATEL, NSE:STLNETWORK"
    "Textiles & Apparels" => "NSE:PAGEIND, NSE:KPRMILL, NSE:VTL, NSE:TRIDENT, NSE:WELSPUNLIV, NSE:ARVIND, NSE:PGIL, NSE:ALOKINDS, NSE:GARFIBRES, NSE:GOKEX, NSE:ICIL, NSE:LUXIND, NSE:RAYMONDLSL, NSE:PDSL, NSE:KITEX, NSE:GANECOS, NSE:JINDWORLD, NSE:SIYSIL, NSE:NITINSPIN, NSE:BOMDYEING, NSE:CANTABIL, NSE:SPAL, NSE:FILATEX, NSE:DOLLAR, NSE:SPORTKING, NSE:SBC, NSE:RUPA, NSE:HIMATSEIDE, NSE:GHCLTEXTIL"
    "Transport Infrastructure" => "NSE:ADANIPORTS, NSE:GMRAIRPORT, NSE:JSWINFRA, NSE:GPPL, NSE:BFUTILITIE"
    "Transport Services" => "NSE:INDIGO, NSE:CONCOR, NSE:DELHIVERY, NSE:GESHIP, NSE:SCI, NSE:BLUEDART, NSE:BLACKBUCK, NSE:SHADOWFAX, NSE:TCI, NSE:SHREEJISPG, NSE:TVSSCS, NSE:MAHLOG, NSE:SEAMECLTD, NSE:SINDHUTRAD, NSE:GATEWAY, NSE:KERNEX, NSE:NAVKARCORP, NSE:ALLCARGO, NSE:RIIL, NSE:RITCO"
    => ""


// --- 4. CALL THE LIBRARY ---
data = engine.calc(data_string, bench_ticker, rs_len) 

// --- 5. PLOTTING: MANSFIELD RS ---
rs_plot = plot(data.rs, "Mansfield RS", color=color.gray, linewidth=1)
z_plot  = plot(0, "Zero Line", color=color.new(#000000, 0))
fill(rs_plot, z_plot, data.rs >= 0 ? data.rs : 0, 0, color.new(#098b76, 25), color.new(#098b76, 25))
fill(rs_plot, z_plot, 0, data.rs < 0 ? data.rs : 0, color.new(#850812, 25), color.new(#850813, 25))

// --- 6. DYNAMIC HEADER ---
display_text = classification_label + " (Eq Wtd): " + user_choice + " (count: " + str.tostring(data.count) + ")"
var head_tab = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(head_tab, 0, 0, display_text, text_color=color.white, bgcolor=color.new(#111111, 10), text_size=size.small)

// --- 7. ALERTS ---
rs_cross_up = ta.crossover(data.rs, 0)
alertcondition(rs_cross_up, title="RS Crossed Above Zero", message="Mansfield RS crossed above 0.")