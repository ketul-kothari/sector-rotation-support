//@version=6
indicator("Group Industry - Equal Weighted Mansfield RS", overlay=false, precision=2, max_bars_back=5000)
import ketul/ChainedIndexEqualWeightLibrary/1 as engine

// --- 1. CONFIGURATION ---
classification_label = "Industry"
bench_ticker         = input.string("NSE:CNX500", "Benchmark for RS")
rs_weeks             = input.int(52, "RS Length (in Weeks)")

rs_len = timeframe.isdaily ? rs_weeks * 5 : rs_weeks

// --- 2. SELECTION ---
user_choice = input.string("Aerospace & Defense", "Select Group", options=[
     "Aerospace & Defense", "Agricultural Food & other Products", "Agricultural, Commercial & Construction Vehicles", "Auto Components", "Automobiles", "Banks", "Beverages", "Capital Markets", "Cement & Cement Products", "Chemicals & Petrochemicals", "Cigarettes & Tobacco Products", "Commercial Services & Supplies", "Construction", "Consumable Fuels", "Consumer Durables", "Diversified", "Diversified FMCG", "Diversified Metals", "Electrical Equipment", "Engineering Services", "Entertainment", "Ferrous Metals", "Fertilizers & Agrochemicals", "Finance", "Financial Technology (Fintech)", "Food Products", "Gas", "Healthcare Equipment & Supplies", "Healthcare Services", "Household Products", "Industrial Manufacturing", "Industrial Products", "Insurance", "IT - Hardware", "IT - Services", "IT - Software", "Leisure Services", "Metals & Minerals Trading", "Minerals & Mining", "Non - Ferrous Metals", "Oil", "Other Construction Materials", "Other Consumer Services", "Other Utilities", "Paper, Forest & Jute Products", "Personal Products", "Petroleum Products", "Pharmaceuticals & Biotechnology", "Power", "Realty", "Retailing", "Telecom - Equipment & Accessories", "Telecom - Services", "Textiles & Apparels", "Transport Infrastructure", "Transport Services"
     ])

